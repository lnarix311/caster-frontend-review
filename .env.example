# Backend API URL (proxied via Next.js rewrites)
BACKEND_URL=http://localhost:9000

# Admin/resolver address -- only this address sees privileged UI (create market, resolve).
# This MUST be the Ethereum address of the resolver configured on the chain (RESOLVER_ADDRESS).
# If not set, no admin UI is shown to anyone (safe default).
# Format: 0x-prefixed, checksummed or lowercase Ethereum address.
NEXT_PUBLIC_ADMIN_ADDRESS=

# Set to "true" to show testnet-only features (faucet button, etc.)
# Remove or set to "false" for mainnet.
# NEXT_PUBLIC_TESTNET_MODE=true

# Network identity. Drives the persistent TESTNET banner across the top of
# every page. Set to "mainnet" to hide the banner. Anything else (or unset)
# shows it -- safe default for testnet/devnet/preview deploys.
# NEXT_PUBLIC_NETWORK=testnet

# Server-side SQLite path for /api/feedback submissions.
# Default: <cwd>/data/feedback.db. On the VPS, point this at a persistent
# volume so feedback survives Next.js redeploys, e.g. /var/lib/caster/feedback.db
# FEEDBACK_DB_PATH=/var/lib/caster/feedback.db
